apiVersion: v1alpha1
kind: AgentConfig
metadata:
  name: {{ cluster_name }}
rendezvousIP: {{ sno_node.ip }}
hosts:
  - hostname: {{ sno_node.hostname }}
    role: master

    # Agent Installer MAC mapping. The names below are deliberately logical
    # names (eth0/eth1), NOT Linux kernel names such as ens33 or ens192.
    # At boot, pre-network-manager-config maps the logical name to the NIC
    # whose MAC matches macAddress and rewrites the generated NM connection.
    interfaces:
      - name: {{ sno_node.primary_logical_interface }}
        macAddress: {{ sno_node.mac_eth0 }}
{% if sno_node.secondary_nic_enabled | default(false) | bool %}
      - name: {{ sno_node.secondary_logical_interface }}
        macAddress: {{ sno_node.mac_eth1 }}
{% endif %}

    networkConfig:
      interfaces:
        - name: {{ sno_node.primary_logical_interface }}
          type: ethernet
          state: up
          # Keep the physical NIC identity in the NMState definition as well as
          # in hosts.interfaces. The Agent Installer maps the logical name to
          # the actual kernel NIC name by this MAC before NetworkManager starts.
          mac-address: {{ sno_node.mac_eth0 }}
          ipv4:
            enabled: true
            dhcp: false
            address:
              - ip: {{ sno_node.ip }}
                prefix-length: {{ machine_cidr_prefix }}
          ipv6:
            enabled: false
{% if sno_node.secondary_nic_enabled | default(false) | bool %}
        - name: {{ sno_node.secondary_logical_interface }}
          type: ethernet
          state: up
          mac-address: {{ sno_node.mac_eth1 }}
          ipv4:
            enabled: false
            dhcp: false
          ipv6:
            enabled: false
{% endif %}

      dns-resolver:
        config:
          server:
{% for dns_server in dns_servers %}
            - {{ dns_server }}
{% endfor %}

      # The next-hop interface is the SAME logical name as above. The Agent
      # boot-time MAC mapping rewrites it to the actual interface name.
      routes:
        config:
          - destination: {{ default_ipv4_route_cidr }}
            next-hop-address: {{ gateway }}
            next-hop-interface: {{ sno_node.primary_logical_interface }}
            table-id: 254
